# Agente local (Windows). Copie para .env e preencha.
MACHINE_ID=pc-casa
TOKEN_URL=https://SEU-PROJETO.vercel.app/api/ably-token
MACHINE_TOKEN=

# MCP oficial do Roblox Studio.
ROBLOX_MCP_CMD=cmd.exe
ROBLOX_MCP_ARGS='["/c","cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"]'

# Ferramentas liberadas para a IA.
ALLOWED_TOOLS=
