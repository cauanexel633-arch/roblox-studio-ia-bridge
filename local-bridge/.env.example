# Servidor local (Windows). Copie para .env e preencha.
MACHINE_ID=pc-casa
TOKEN_URL=https://SEU-PROJETO.vercel.app/api/ably-token
MACHINE_TOKEN=

# MCP oficial do Roblox Studio (mesma configuração do Claude Desktop).
# ROBLOX_MCP_ARGS é um array JSON. Use aspas simples para a linha inteira
# e escreva as barras invertidas duplas, como no exemplo.
ROBLOX_MCP_CMD=cmd.exe
ROBLOX_MCP_ARGS='["/c","cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"]'

# Ferramentas do MCP que a IA pode usar, separadas por vírgula. Vazio = nenhuma.
ALLOWED_TOOLS=
